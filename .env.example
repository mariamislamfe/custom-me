# Copy to .env.local (on your computer) or set these in your host's environment.

# Dashboard password for /admin. Use a long, unique password.
ADMIN_PASSWORD=

# Optional: extra secret mixed into dashboard sessions and upload links.
ADMIN_SESSION_SECRET=

# Your live domain, e.g. https://customme.store (used for notification links).
SITE_URL=

# Supabase → Project Settings → API. Leave empty to keep everything in the
# local data/ folder (fine on your computer, NOT on Vercel).
NEXT_PUBLIC_SUPABASE_URL=
# Secret: server only. Never commit it or put it in client code.
SUPABASE_SERVICE_ROLE_KEY=
